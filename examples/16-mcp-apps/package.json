{
  "name": "mcp-apps-examples",
  "version": "1.0.0",
  "description": "Three independent Mastra MCP Apps: a loan calculator, collaborative tic-tac-toe, and a product metrics dashboard.",
  "main": "index.js",
  "private": true,
  "scripts": {
    "dev": "npm run build:apps && mastra dev",
    "build": "npm run build:apps && mastra build",
    "build:apps": "node scripts/build-apps.mjs",
    "start": "mastra start",
    "typecheck": "npm run build:apps && tsc --noEmit",
    "test": "npm run build:apps && tsx --test tests/*.test.ts",
    "test:ui": "npm run build:apps && playwright test",
    "test:smoke": "node scripts/smoke-mcp.mjs",
    "preview": "npm run build:apps && tsx tests/host/server.ts"
  },
  "keywords": [],
  "author": "",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@mastra/core": "1.75.0",
    "@mastra/duckdb": "1.13.0",
    "@mastra/libsql": "1.25.1",
    "@mastra/mcp": "^2.2.0",
    "@mastra/memory": "1.36.0",
    "@mastra/observability": "1.18.4",
    "@modelcontextprotocol/ext-apps": "^2.0.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.3.1",
    "@playwright/test": "^1.64.0",
    "@types/node": "latest",
    "esbuild": "^0.28.2",
    "mastra": "1.33.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  }
}
