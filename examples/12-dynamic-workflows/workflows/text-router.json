{
  "id": "text-router",
  "description": "Analyze a text, then branch: short texts get shouted, long texts get whispered",
  "inputSchema": {
    "type": "object",
    "properties": { "text": { "type": "string" } },
    "required": ["text"]
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "result": { "type": "string" },
      "words": { "type": "number" }
    },
    "required": ["result", "words"]
  },
  "graph": [
    { "type": "tool", "id": "stats", "toolId": "word-stats" },
    {
      "type": "conditional",
      "steps": [
        { "type": "tool", "id": "shout", "toolId": "shout-text" },
        { "type": "tool", "id": "whisper", "toolId": "whisper-text" }
      ],
      "predicates": [
        { "op": "lte", "left": { "path": "inputData.words" }, "right": { "literal": 4 } },
        { "op": "gt", "left": { "path": "inputData.words" }, "right": { "literal": 4 } }
      ]
    },
    {
      "type": "mapping",
      "id": "pick-result",
      "mapConfig": "{\"result\":{\"step\":[\"shout\",\"whisper\"],\"path\":\"text\"},\"words\":{\"step\":\"stats\",\"path\":\"words\"}}"
    }
  ]
}
