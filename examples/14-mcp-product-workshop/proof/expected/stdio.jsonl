{"direction":"body","body":{"result":{"tools":[{"name":"getOrder","description":"Read one order in the authenticated tenant. Requires an ORD identifier. No side effects. Do not use to create returns. Unavailable orders are forbidden.","inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{"orderId":{"type":"string","pattern":"^ORD-\\d{3}$"}},"required":["orderId"],"additionalProperties":false},"outputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{"id":{"type":"string","pattern":"^ORD-\\d{3}$"},"totalCents":{"type":"integer","minimum":0,"maximum":9007199254740991},"ageDays":{"type":"integer","minimum":0,"maximum":9007199254740991},"status":{"type":"string","enum":["delivered","returned"]},"correlationId":{"type":"string","pattern":"^[0-9a-f]{32}$"}},"required":["id","totalCents","ageDays","status"],"additionalProperties":false}},{"name":"checkReturnEligibility","description":"Check return eligibility and high-value confirmation requirements for one authenticated-tenant order. Read only; does not reserve or create a return.","inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{"orderId":{"type":"string","pattern":"^ORD-\\d{3}$"}},"required":["orderId"],"additionalProperties":false},"outputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{"orderId":{"type":"string","pattern":"^ORD-\\d{3}$"},"eligible":{"type":"boolean"},"reason":{"type":"string","enum":["ELIGIBLE","EXPIRED","ALREADY_RETURNED"]},"requiresConfirmation":{"type":"boolean"}},"required":["orderId","eligible","reason","requiresConfirmation"],"additionalProperties":false}},{"name":"createReturn","description":"Create one return in the authenticated tenant using an orderId, reason, and stable idempotencyKey. Writes once; reuse the same key and request to retry. Ineligible orders fail. High-value returns require explicit user confirmation through MCP elicitation; without it no write occurs. Never supply identity or confirmation as arguments.","inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{"orderId":{"type":"string","pattern":"^ORD-\\d{3}$"},"idempotencyKey":{"type":"string","minLength":8,"maxLength":100},"reason":{"type":"string","enum":["damaged","wrong-item","changed-mind"]}},"required":["orderId","idempotencyKey","reason"],"additionalProperties":false},"outputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{"id":{"type":"string"},"orderId":{"type":"string","pattern":"^ORD-\\d{3}$"},"refundCents":{"type":"integer","minimum":0,"maximum":9007199254740991},"status":{"type":"string","const":"created"}},"required":["id","orderId","refundCents","status"],"additionalProperties":false}},{"name":"processReturn","description":"Create a return and shipping label in the authenticated account. Use for the full return process, not order lookup. Shipping is simulated. On needs_retry, the return exists: retry with the SAME idempotencyKey. High-value returns need createReturn confirmation first; then reuse that key here.","inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{"orderId":{"type":"string","pattern":"^ORD-\\d{3}$"},"idempotencyKey":{"type":"string","minLength":8,"maxLength":100},"reason":{"type":"string","enum":["damaged","wrong-item","changed-mind"]}},"required":["orderId","idempotencyKey","reason"],"additionalProperties":false},"outputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","oneOf":[{"type":"object","properties":{"return":{"type":"object","properties":{"id":{"type":"string"},"orderId":{"type":"string","pattern":"^ORD-\\d{3}$"},"refundCents":{"type":"integer","minimum":0,"maximum":9007199254740991},"status":{"type":"string","const":"created"}},"required":["id","orderId","refundCents","status"],"additionalProperties":false},"label":{"type":"object","properties":{"id":{"type":"string"},"returnId":{"type":"string"},"carrier":{"type":"string","const":"Demo Post"}},"required":["id","returnId","carrier"],"additionalProperties":false},"instructions":{"type":"string"},"status":{"type":"string","const":"completed"}},"required":["return","label","instructions","status"],"additionalProperties":false},{"type":"object","properties":{"status":{"type":"string","const":"needs_retry"},"return":{"type":"object","properties":{"id":{"type":"string"},"orderId":{"type":"string","pattern":"^ORD-\\d{3}$"},"refundCents":{"type":"integer","minimum":0,"maximum":9007199254740991},"status":{"type":"string","const":"created"}},"required":["id","orderId","refundCents","status"],"additionalProperties":false},"message":{"type":"string"}},"required":["status","return","message"],"additionalProperties":false},{"type":"object","properties":{"error":{"type":"object","properties":{"code":{"type":"string","enum":["UNAUTHORIZED","FORBIDDEN","INVALID_INPUT","INELIGIBLE","CONFIRMATION_REQUIRED","CONFLICT","CANCELLED","INTERNAL"]},"message":{"type":"string"}},"required":["code","message"],"additionalProperties":false},"status":{"type":"string","const":"rejected"}},"required":["error","status"],"additionalProperties":false}]}},{"name":"returnRiskScore","description":"Read a deterministic workshop risk score (0–100) for one authenticated-tenant order: 100 if ineligible, 80 if high value, otherwise 20. This is a policy heuristic, not a fraud prediction or approval. No writes; never replaces eligibility checks or high-value confirmation.","inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{"orderId":{"type":"string","pattern":"^ORD-\\d{3}$"}},"required":["orderId"],"additionalProperties":false},"outputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"integer","minimum":0,"maximum":100}}],"resultType":"complete","ttlMs":0,"cacheScope":"private","_meta":{"io.modelcontextprotocol/serverInfo":{"name":"